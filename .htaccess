# =========================================================================
# typodwnetrz.pl - konfiguracja serwera Apache / LiteSpeed
# Strona jest statyczna, więc ten plik robi cztery rzeczy: wymusza HTTPS
# i jedną wersję adresu, chowa to, co nie ma być publiczne, włącza kompresję
# i ustawia cache.
# =========================================================================

# --- HTTPS + wersja BEZ www ---------------------------------------------
# Canonical, sitemap.xml i JSON-LD wskazują https://typodwnetrz.pl (bez www),
# więc serwer musi prowadzić tam samo. Jedno przekierowanie 301, nie łańcuch.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://typodwnetrz.pl%{REQUEST_URI} [R=301,L]

# --- Własna strona 404 ---------------------------------------------------
ErrorDocument 404 /404.html

# --- Czego nie wolno wystawiać -------------------------------------------
# .git to pełna historia źródeł. Jeśli kiedykolwiek trafi na serwer przez
# pomyłkę, ta reguła i tak go zasłoni.
RedirectMatch 404 /\.git
RedirectMatch 404 /\.idea
# Notatki projektowe, narzędzia i pliki robocze - nie są treścią strony.
<FilesMatch "\.(md|java|json|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^_">
  Require all denied
</FilesMatch>
# Bez listingu katalogów - inaczej /images/pdf/ pokazuje spis plików.
Options -Indexes

# --- Kompresja -----------------------------------------------------------
# WebP, MP4 i PDF są już skompresowane, nie ma sensu ich pakować drugi raz.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Cache ---------------------------------------------------------------
# Pliki HTML NIE mają wersji w adresie, więc muszą wygasać szybko.
# CSS, JS i dane mają ?v=..., a obrazy i wideo się nie zmieniają - te mogą
# leżeć w cache rok.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html               "access plus 10 minutes"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType application/pdf         "access plus 1 month"
  ExpiresByType application/xml         "access plus 1 day"
</IfModule>

# --- Typy MIME -----------------------------------------------------------
# Gdyby hosting ich nie znał: bez poprawnego typu wideo hero się nie odtworzy,
# a WebP pobierze się zamiast wyświetlić.
AddType image/webp  .webp
AddType video/mp4   .mp4
AddType image/svg+xml .svg

# --- Nagłówki bezpieczeństwa --------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Strona nie używa kamery, mikrofonu ani geolokalizacji.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
